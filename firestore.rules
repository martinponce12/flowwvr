rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/administradores/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.activo == true;
    }

    // Catálogo: lectura pública de productos publicados, escritura solo admin.
    match /productos/{productoId} {
      allow read: if resource.data.publicado == true || esAdmin();
      allow write: if esAdmin();
    }

    match /categorias/{categoriaId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /zonasEnvio/{zonaId} {
      allow read: if resource.data.activa == true || esAdmin();
      allow write: if esAdmin();
    }

    match /promociones/{promoId} {
      allow read: if resource.data.activa == true || esAdmin();
      allow write: if esAdmin();
    }

    // Pedidos: cualquier visitante (aunque no esté logueado) puede CREAR un
    // pedido al hacer checkout — es el flujo normal de una tienda online.
    // Pero solo el admin puede LEER la lista completa, editar o borrar, para
    // que un cliente nunca pueda ver pedidos ajenos ni cambiar un estado.
    // La consulta pública de "mi pedido" (sección Seguimiento) no usa esta
    // regla: pasa por una Netlify Function con Firebase Admin SDK, que
    // valida DNI + ID de pedido antes de devolver el estado.
    match /pedidos/{pedidoId} {
      allow create: if request.resource.data.cliente is string &&
        request.resource.data.dni is string &&
        request.resource.data.total is number &&
        request.resource.data.estadoPedido in ['pendiente_pago', 'esperando_comprobante'];
      allow read, update, delete: if esAdmin();
    }

    match /configuracion/{docId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /administradores/{uid} {
      allow read: if esAdmin();
      allow write: if false; // alta de administradores se hace manualmente desde la consola de Firebase
    }
  }
}
