# Copiar este archivo como ".env" para desarrollo local.
# En producción, estas mismas variables se cargan en Netlify (ver README paso a paso).

# --- Firebase (Configuración del proyecto > Config web) ---
# Si dejás estas 6 variables vacías, la app arranca igual en "modo demo"
# (con datos de ejemplo, sin conectar a Firestore real).
VITE_FIREBASE_API_KEY=AIzaSyCOX1eyAs85jD3pF3QpSnKop5VYIzrn9hc
VITE_FIREBASE_AUTH_DOMAIN=flowwvr-ff0d9.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=flowwvr-ff0d9
VITE_FIREBASE_STORAGE_BUCKET=flowwvr-ff0d9.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=518783313423
VITE_FIREBASE_APP_ID=1:518783313423:web:f599db15a917426186257a

# --- Mercado Pago ---
# true/false: controla si el checkout muestra la opción de pagar con Mercado Pago.
# Ponelo en true recién cuando MERCADOPAGO_ACCESS_TOKEN (abajo) ya esté cargado.
VITE_MP_HABILITADO=false

# Access Token PRIVADO (nunca con prefijo VITE_, nunca en el frontend).
# Se usa solo dentro de netlify/functions.
MERCADOPAGO_ACCESS_TOKEN=

# --- Firebase Admin SDK (solo para las Netlify Functions) ---
# Firebase Console → Configuración del proyecto → Cuentas de servicio →
# "Generar nueva clave privada". Del JSON que se descarga, copiar estos 3 valores.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
