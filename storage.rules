rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function esAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/administradores/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/administradores/$(request.auth.uid)).data.activo == true;
    }

    // Fotos de producto: lectura pública, escritura solo administradores.
    match /productos/{archivo} {
      allow read: if true;
      allow write: if esAdmin();
    }
  }
}
