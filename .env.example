# Copiar este archivo como ".env" para desarrollo local.
# En producción, estas mismas variables se cargan en Netlify (ver README paso a paso).

# --- Firebase (Configuración del proyecto > Config web) ---
# Si dejás estas 6 variables vacías, la app arranca igual en "modo demo"
# (con datos de ejemplo, sin conectar a Firestore real).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Mercado Pago ---
# true/false: controla si el checkout muestra la opción de pagar con Mercado Pago.
# Ponelo en true recién cuando MERCADOPAGO_ACCESS_TOKEN (abajo) ya esté cargado.
VITE_MP_HABILITADO=false

# --- Firebase Storage ---
# true/false: controla si el panel admin muestra el botón de "subir foto desde el
# dispositivo". Firebase exige el plan Blaze para aprovisionar el bucket de Storage
# (ver README). Mientras esto esté en false, el admin carga fotos pegando una URL.
# Cuando actives Blaze + Storage en Firebase Console, cambiá esto a true y listo:
# no hace falta tocar ni una línea de código.
VITE_STORAGE_HABILITADO=false

# Access Token PRIVADO (nunca con prefijo VITE_, nunca en el frontend).
# Se usa solo dentro de netlify/functions.
MERCADOPAGO_ACCESS_TOKEN=

# --- Firebase Admin SDK (solo para las Netlify Functions) ---
# Firebase Console → Configuración del proyecto → Cuentas de servicio →
# "Generar nueva clave privada". Del JSON que se descarga, copiar estos 3 valores.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Resend (emails transaccionales) ---
# resend.com → crear cuenta gratis (3.000 emails/mes, sin tarjeta) → API Keys → crear una.
# Si dejás esto vacío, la app funciona igual: simplemente no manda los mails de
# confirmación de pedido / pago confirmado.
RESEND_API_KEY=
# Opcional: dejalo vacío para usar el remitente de pruebas de Resend
# (onboarding@resend.dev). Para usar un email propio (ej. hola@flowwvr.com)
# hay que verificar un dominio propio en Resend primero.
RESEND_FROM_EMAIL=
